<IfModule mod_rewrite.c>
    RewriteEngine on
    RewriteRule ^$ public/ [L]
    RewriteRule ((?s).*) public/$1 [L]
</IfModule>

# Increase PHP upload limits for large file uploads
php_value upload_max_filesize 100M
php_value post_max_size 100M
php_value max_execution_time 300
php_value max_input_time 300

# Default max_file_uploads is 20 — bulk image uploads (multimedia manager,
# gallery components) silently drop every file past the 20th with no error
# if this isn't raised.
php_value max_file_uploads 200
